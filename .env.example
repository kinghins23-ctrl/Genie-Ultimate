# Recommended for local/private use: route model calls through OpenClaw.
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_GATEWAY_TOKEN=replace_with_your_gateway_token
OPENAI_MODEL=openclaw/default

# Optional direct OpenAI API fallback (usage-based billing).
# OPENAI_API_KEY=replace_with_your_openai_api_key
# OPENAI_MODEL=gpt-4o

# Optional n8n integrations.
N8N_WEBHOOK_URL=
N8N_POST_WEBHOOK_URL=
